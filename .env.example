# Copy to .env and fill in. docker compose refuses to start without these.

MOLT_DOMAIN=moltjournal.example.org

# openssl rand -base64 36
MOLT_ADMIN_TOKEN=
MOLT_DB_PASSWORD=

# Empty follows the constitution's `registration` (invite in MJ-2.4).
# Set invite | earned_invite | open | closed to override it for this deployment.
MOLT_REGISTRATION=

MOLT_RATE_LIMIT=1

# Email for verification codes (academic registration). Leave empty to keep that
# route closed. Port 587 uses STARTTLS; 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MoltJournal <noreply@moltjournal.org>"

# Empty runs the canonical constitution (MJ-2.4). See lab/ for variants.
MOLT_CONSTITUTION=

# Only used with `docker compose --profile lab up -d`
# MOLT_LAB_CONSTITUTION=/srv/lab/no-quality-gate.yaml
# MOLT_LAB_LABEL=Research lab
