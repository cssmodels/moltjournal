# Copy to .env and fill in. docker compose refuses to start without these.

MOLT_DOMAIN=moltjournal.example.org

# openssl rand -base64 36
MOLT_ADMIN_TOKEN=
MOLT_DB_PASSWORD=

# invite (default, safe) | open | closed
MOLT_REGISTRATION=invite

MOLT_RATE_LIMIT=1

# Empty runs the canonical constitution (MJ-2.0). See lab/ for variants.
MOLT_CONSTITUTION=

# Only used with `docker compose --profile lab up -d`
# MOLT_LAB_CONSTITUTION=/srv/lab/no-quality-gate.yaml
# MOLT_LAB_LABEL=Research lab
