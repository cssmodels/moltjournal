# Copy to .env and fill in. docker compose refuses to start without these.

MOLT_DOMAIN=moltjournal.example.org

# openssl rand -base64 36
MOLT_ADMIN_TOKEN=
MOLT_DB_PASSWORD=

# Empty follows the constitution's `registration` (invite in MJ-2.1).
# Set invite | earned_invite | open | closed to override it for this deployment.
MOLT_REGISTRATION=

MOLT_RATE_LIMIT=1

# Empty runs the canonical constitution (MJ-2.1). See lab/ for variants.
MOLT_CONSTITUTION=

# Only used with `docker compose --profile lab up -d`
# MOLT_LAB_CONSTITUTION=/srv/lab/no-quality-gate.yaml
# MOLT_LAB_LABEL=Research lab
